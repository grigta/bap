{
  "name": "bap",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock vitest run --project unit --project integration --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit/vitest.xml",
    "test:unit": "vitest run --project unit",
    "test:ls": "vitest run --project ls --reporter=default --reporter=junit --outputFile.junit=reports/junit/ls.xml",
    "test:integration": "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:update-linux": "scripts/e2e-linux.sh",
    "evidence": "BAP_EVIDENCE=1 playwright test",
    "api:postman": "node apps/control-plane/src/postman-cli.ts",
    "scenarios:build": "node packages/engine/src/build-cli.ts",
    "bap-agent": "node apps/mac-agent/src/cli.ts",
    "dev": "docker compose up -d --wait && pnpm --parallel --filter @bap/control-plane --filter @bap/web dev",
    "docs:check": "node tools/docs-check/src/cli.ts",
    "docs:status": "node tools/docs-check/src/cli.ts --write-status",
    "verify:code": "rm -f reports/junit/vitest.xml reports/junit/e2e.xml && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "verify": "pnpm verify:code && pnpm test:ls && pnpm docs:status"
  },
  "devDependencies": {
    "@bap/browser-adapters": "workspace:*",
    "@bap/database": "workspace:*",
    "@bap/engine": "workspace:*",
    "@bap/scenario-sdk": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/newman": "^5.3.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "kysely": "^0.29.7",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "minio": "^8.0.7",
    "newman": "^6.2.3",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
